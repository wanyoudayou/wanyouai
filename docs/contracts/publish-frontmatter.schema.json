{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanyou.ai/schemas/publish-frontmatter-0.1.json",
  "title": "万有AI publish frontmatter",
  "description": "Article frontmatter accepted by the single authoritative POST /api/publish pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "type",
    "access"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 120
    },
    "type": {
      "enum": [
        "blog",
        "chapter",
        "skill"
      ]
    },
    "access": {
      "enum": [
        "public",
        "registered",
        "subscriber",
        "paid"
      ]
    },
    "series_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 120,
      "description": "Required for chapter; forbidden for blog."
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 999999.99,
      "multipleOf": 0.01,
      "description": "Required only for an independent paid blog article."
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "cover": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Relative vault/media path or canonical public URL. The publish pipeline resolves and rewrites local media."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "uniqueItems": true,
      "maxItems": 20
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "chapter"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "series_slug"
        ],
        "properties": {
          "price": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "blog"
          },
          "access": {
            "const": "paid"
          }
        },
        "required": [
          "type",
          "access"
        ]
      },
      "then": {
        "required": [
          "price"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "blog"
          },
          "access": {
            "not": {
              "const": "paid"
            }
          }
        },
        "required": [
          "type",
          "access"
        ]
      },
      "then": {
        "properties": {
          "price": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "blog"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "series_slug": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "skill"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "access": {
            "const": "public"
          },
          "price": false,
          "series_slug": false
        }
      }
    }
  ]
}
