{
  "name": "wanyou",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "contracts": "node scripts/validate-contracts.mjs && npm run tokens:check && npm run starter:check",
    "docs:check": "node scripts/check-doc-links.mjs",
    "dev:webpack": "next dev --webpack",
    "test:content": "node --import tsx --test tests/content-*.test.ts*",
    "test:content:smoke": "node scripts/check-content-routes.mjs",
    "test:publish": "node --import tsx --test tests/publish-*.test.ts",
    "test:admin": "node --import tsx --test tests/admin-*.test.ts",
    "drill:fresh-db": "node scripts/drill-fresh-db.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:config": "node --test tests/config-*.test.mjs",
    "db:baseline": "node scripts/build-database-baseline.mjs",
    "db:baseline:check": "node scripts/build-database-baseline.mjs --check",
    "test:avatar": "node --import tsx --test tests/avatar-*.test.ts",
    "test:ai": "node --import tsx --test tests/ai-*.test.ts tests/admin-ai-settings.test.ts",
    "test:skills": "node --import tsx --test tests/skill-*.test.ts tests/admin-skills.test.ts",
    "embedding:check": "node scripts/check-embedding.mjs",
    "test:embedding": "node --test tests/embedding-probe.test.mjs",
    "test:db:concurrency": "node --import tsx --test --test-concurrency=1 tests/database-concurrency.test.mjs",
    "test:scale": "node --import tsx scripts/benchmark-scale.mjs",
    "test:security:smoke": "node scripts/check-security-routes.mjs",
    "test:availability": "node scripts/check-availability.mjs",
    "storage:setup": "node scripts/storage-setup.mjs",
    "test:storage": "node --test tests/storage-setup.test.mjs",
    "media:maintain": "node --import tsx scripts/media-maintenance.mjs",
    "test:db:media": "node --test tests/media-relocation.test.mjs",
    "test:mail:scheduler": "node --test tests/mail-scheduler.test.mjs",
    "test:payment:scheduler": "node --test tests/payment-reconcile-scheduler.test.mjs",
    "tokens:build": "node scripts/build-design-tokens.mjs",
    "tokens:check": "node scripts/build-design-tokens.mjs --check",
    "starter:build": "node scripts/build-starter-content.mjs",
    "starter:check": "node scripts/build-starter-content.mjs --check",
    "test:browser": "playwright test",
    "plugin:build": "node scripts/build-obsidian.mjs",
    "plugin:check": "node scripts/build-obsidian.mjs --check",
    "test:handbooks": "node --import tsx --test tests/handbook-*.test.ts",
    "release:package": "node scripts/release-package.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.89",
    "@ai-sdk/openai": "4.0.103",
    "@ai-sdk/openai-compatible": "3.0.79",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-table": "8.21.3",
    "ai": "7.0.154",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "beautiful-mermaid": "1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "lucide-react": "^1.45.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "@types/yauzl": "3.4.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "obsidian": "1.14.4",
    "pg": "8.23.0",
    "supabase": "2.118.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5"
  },
  "type": "module"
}
